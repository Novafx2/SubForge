# =============================================================================
# SUBFORGE SERVER & AI ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy to .env (for local/VPS hosting) or configure in your hosting provider's
# Secrets / Environment Variables panel. Never commit real secrets to git.

# Google Gemini API Key (required for AI Support Chatbot, AI Chapters & AI Translation)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Server Port & Public Application URL
PORT=3000
NODE_ENV=production
APP_URL="https://your-domain.com"

# =============================================================================
# ADMINISTRATOR CONSOLE SECURITY (REQUIRED FOR LIVE DEPLOYMENT)
# =============================================================================
# Admin username shown in /admin/login (defaults to SubForgeAdmin if omitted)
ADMIN_USERNAME="SubForgeAdmin"

# Pre-hashed salted scrypt password in "<saltHex>:<derivedKeyHex>" format.
# If omitted on first boot, set a strong password or generate a hash and set it here.
ADMIN_PASSWORD_HASH=""

# Secret used to sign HttpOnly admin session cookies (set a long random string in prod)
ADMIN_SESSION_SECRET=""

# Private bootstrap secret for one-click admin bootstrap & credential rotation
ADMIN_BOOTSTRAP_SECRET=""
